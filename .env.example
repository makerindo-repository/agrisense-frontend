# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Laravel application key for Docker/production.
# Generate real value with: php artisan key:generate --show
APP_KEY=

# Docker database user used by docker-compose.
DB_DATABASE=agrisense
DB_APP_USERNAME=agrisense
DB_APP_PASSWORD=change_this_db_password
DB_ROOT_PASSWORD=change_this_root_password

# Telegram alerts and daily reports.
# Create a bot with @BotFather, then get chat_id from getUpdates or @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts. Use MAIL_MAILER=log to only write emails to Laravel logs.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@agrisense.id
MAIL_FROM_NAME=AgriSense
