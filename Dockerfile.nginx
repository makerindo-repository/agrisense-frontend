# Stage 1: Build the React application
FROM node:18-alpine AS build-stage
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Stage 2: Serve the application with Nginx
FROM nginx:alpine
COPY --from=build-stage /app/dist /var/www/frontend
EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
